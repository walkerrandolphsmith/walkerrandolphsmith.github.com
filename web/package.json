{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "analyze": "ANALYZE=true yarn workspace web build",
    "bundle": "concurrently \"yarn optimize:images\" \"yarn build:favicons\" \"yarn build:app\"",
    "build": "yarn build:sequences && yarn bundle && yarn export:images && yarn build:social-cards && yarn package",
    "build:app": "next build",
    "build:css": "@tailwindcss/cli -i ./src/app/globals.css -o ./src/app/generated.css --minify",
    "build:favicons": "ts-node --project ./tsconfig.build.json ./scripts/generateFavicons.ts",
    "export:images": "next-image-export-optimizer",
    "build:images": "yarn optimize:images && yarn build:favicons",
    "build:social-cards": "node ./scripts/generateSocialCards.ts",
    "build:sequences": "ts-node --project ./tsconfig.build.json ./scripts/generateSequences.ts",
    "package": "ts-node --project ./tsconfig.build.json ./scripts/build.ts",
    "optimize:images": "ts-node --project ./tsconfig.build.json ./scripts/optimizeImages.ts",
    "start": "serve ./out",
    "lint": "next lint --fix",
    "test": "node --test 'src/**/*.test.ts'",
    "upgrade": "yarn run @tailwindcss/upgrade"
  },
  "dependencies": {
    "@next/bundle-analyzer": "^15.5.29",
    "@serwist/next": "^9.6.0",
    "@tailwindcss/cli": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/upgrade": "^4.3.5",
    "canvas": "^3.2.3",
    "contentlayer2": "^0.5.8",
    "developer-icons": "^7.1.0",
    "favicons": "^7.3.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "jsdom": "^29.1.1",
    "next": "^15.5.29",
    "next-image-export-optimizer": "^1.21.2",
    "pliny": "^0.4.1",
    "postcss": "^8.5.34",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-intersection-observer": "^11.0.1",
    "react-type-animation": "^3.1.0",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "concurrently": "^9.2.5",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "serwist": "^9.6.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
